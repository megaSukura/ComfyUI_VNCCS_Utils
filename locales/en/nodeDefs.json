  "VNCCS_PositionControl": {
    "display_name": "VNCCS Position Control",
    "inputs": {
      "azimuth": {
        "name": "azimuth",
        "tooltip": "Angle of the camera around the subject (0=Front, 90=Right, 180=Back)"
      },
      "elevation": {
        "name": "elevation",
        "tooltip": "Vertical angle of the camera (-30=Low, 0=Eye Level, 60=High)"
      },
      "distance": {
        "name": "distance"
      },
      "include_trigger": {
        "name": "include_trigger",
        "tooltip": "Include <sks> trigger word"
      }
    },
    "outputs": {
      "0": {
        "name": "prompt"
      }
    }
  },
