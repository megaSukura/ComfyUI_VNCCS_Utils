  "VNCCS_FactoryRender": {
    "display_name": "VNCCS Factory Render",
    "description": "Capture RGB, metric depth, view normals and object masks from the connected 3D Factory scene. Fresh captures require its open widget in 3D view.",
    "inputs": {
      "scene": {
        "name": "scene"
      },
      "profile": {
        "name": "profile",
        "tooltip": "Gaussian splats require explicit coarse box approval. Boxes are approximate conditioning geometry."
      },
      "width": {
        "name": "width"
      },
      "height": {
        "name": "height"
      },
      "depth_min": {
        "name": "depth_min",
        "tooltip": "Meters; white in the depth preview."
      },
      "depth_max": {
        "name": "depth_max",
        "tooltip": "Meters; black in the preview. Raw metric depth is retained independently."
      }
    },
    "outputs": {
      "0": {
        "name": "rgb"
      },
      "1": {
        "name": "depth"
      },
      "2": {
        "name": "normal"
      },
      "3": {
        "name": "alpha"
      },
      "4": {
        "name": "object_id"
      },
      "5": {
        "name": "camera_metadata"
      },
      "6": {
        "name": "capture"
      }
    }
  },
  "VNCCS_FactoryMask": {
    "display_name": "VNCCS Factory Mask",
    "description": "Select exact entity IDs from a Factory capture. White means selected foreground. Empty selection selects all geometry.",
    "inputs": {
      "capture": {
        "name": "capture"
      },
      "entities": {
        "name": "entities",
        "tooltip": "Comma/newline-separated entity keys from camera_metadata, e.g. object:<id>, wall:<id>, room:<id>. Empty selects all."
      },
      "invert": {
        "name": "invert"
      },
      "grow_pixels": {
        "name": "grow_pixels",
        "tooltip": "Positive dilates; negative erodes."
      },
      "feather_pixels": {
        "name": "feather_pixels"
      }
    },
    "outputs": {
      "0": {
        "name": "mask"
      },
      "1": {
        "name": "metadata"
      }
    }
  }
