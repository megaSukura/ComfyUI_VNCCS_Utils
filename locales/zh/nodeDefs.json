{
  "VNCCS_PositionControl": {
    "display_name": "VNCCS 位置控制",
    "inputs": {
      "azimuth": {
        "name": "方位角",
        "tooltip": "相机围绕主体的角度（0=正面，90=右侧，180=背面）"
      },
      "elevation": {
        "name": "俯仰角",
        "tooltip": "相机的垂直角度（-30=低角度，0=平视，60=高角度）"
      },
      "distance": {
        "name": "取景距离"
      },
      "include_trigger": {
        "name": "包含触发词",
        "tooltip": "包含 <sks> 触发词"
      }
    },
    "outputs": {
      "0": {
        "name": "提示词"
      }
    }
  },
  "VNCCS_VisualPositionControl": {
    "display_name": "VNCCS 可视化相机控制",
    "outputs": {
      "0": {
        "name": "提示词"
      }
    }
  },
  "VNCCS_BBox_Extractor": {
    "display_name": "VNCCS 边界框提取器",
    "inputs": {
      "image": {
        "name": "图像"
      },
      "bbox_detector": {
        "name": "边界框检测器"
      },
      "threshold": {
        "name": "阈值"
      },
      "dilation": {
        "name": "扩展像素"
      },
      "drop_size": {
        "name": "忽略尺寸"
      }
    },
    "outputs": {
      "0": {
        "name": "图像"
      }
    }
  },
  "VNCCS_PoseStudio": {
    "display_name": "VNCCS 姿势工作室",
    "inputs": {
      "pose_data": {
        "name": "姿势数据"
      },
      "pose_image": {
        "name": "姿势图像"
      },
      "camera_prompt": {
        "name": "相机提示词",
        "tooltip": "来自 VNCCS 可视化相机控制的相机方向。"
      },
      "animation_image_batch": {
        "name": "动画图像批次",
        "tooltip": "将动画帧作为单个图像批次返回，而不是视频。"
      }
    },
    "outputs": {
      "0": {
        "name": "图像"
      },
      "1": {
        "name": "光照提示词"
      }
    }
  },
  "VNCCS_PoseLibraryCreator": {
    "display_name": "VNCCS 姿势库创建器",
