      },
      "seed": {
        "name": "随机种"
      },
      "resolution_scale": {
        "name": "分辨率缩放"
      },
      "steps": {
        "name": "步数"
      },
      "cfg": {
        "name": "CFG"
      },
      "sampler_name": {
        "name": "采样器"
      },
      "scheduler": {
        "name": "调度器"
      },
      "category": {
        "name": "分类",
        "tooltip": "覆盖生成的分类。留空则自动分类。"
      },
      "tags": {
        "name": "标签",
        "tooltip": "额外的逗号分隔标签。会添加到生成的标签中，重复项忽略大小写。"
      }
    },
    "outputs": {
      "0": {
        "name": "图像"
      }
    }
  },
