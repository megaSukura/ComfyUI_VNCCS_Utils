  "VNCCS_3DFactory": {
    "display_name": "VNCCS 3D 工厂",
    "inputs": {
      "factory_data": {
        "name": "工厂数据"
      }
    },
    "outputs": {
      "0": {
        "name": "预览"
      },
      "1": {
        "name": "场景"
      }
    }
  },
  "VNCCS_FactoryRender": {
    "display_name": "VNCCS 工厂渲染",
    "description": "从连接的 3D 工厂场景采集中采集 RGB、度量深度、视角法线和对象蒙版。实时采集需要它的组件在 3D 视图中打开。",
    "inputs": {
      "scene": {
        "name": "场景"
      },
      "profile": {
        "name": "采集配置",
        "tooltip": "高斯泼溅需要显式批准粗略包围盒。包围盒是近似的条件几何体。"
      },
      "width": {
        "name": "宽度"
      },
      "height": {
        "name": "高度"
      },
      "depth_min": {
        "name": "深度最小值",
        "tooltip": "单位：米；在深度预览中显示为白色。"
      },
      "depth_max": {
        "name": "深度最大值",
        "tooltip": "单位：米；在预览中显示为黑色。原始度量深度会单独保留。"
      }
    },
    "outputs": {
      "0": {
        "name": "RGB"
      },
      "1": {
        "name": "深度"
      },
      "2": {
        "name": "法线"
      },
      "3": {
        "name": "透明度"
      },
      "4": {
        "name": "对象 ID"
      },
      "5": {
        "name": "相机元数据"
      },
      "6": {
        "name": "采集"
      }
    }
  },
  "VNCCS_FactoryMask": {
    "display_name": "VNCCS 工厂蒙版",
    "description": "从工厂采集中选择精确的实体 ID。白色表示选中的前景。空选择会选中所有几何体。",
    "inputs": {
      "capture": {
        "name": "采集"
      },
      "entities": {
        "name": "实体",
        "tooltip": "来自 camera_metadata 的实体键，用逗号或换行分隔，例如 object:<id>、wall:<id>、room:<id>。留空则选择全部。"
      },
      "invert": {
        "name": "反转"
      },
      "grow_pixels": {
        "name": "扩展像素",
        "tooltip": "正值膨胀，负值腐蚀。"
      },
      "feather_pixels": {
        "name": "羽化像素"
      }
    },
    "outputs": {
      "0": {
        "name": "蒙版"
      },
      "1": {
        "name": "元数据"
      }
    }
  }
}
